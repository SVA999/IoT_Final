DWH_USER=dwh
DWH_PASSWORD=cambiame
DWH_DB=plantas
# CrateDB: usuario "iot" (se crea con doc/crate_auth.sh). Evita comillas simples y $ en la clave.
CRATE_PASSWORD=cambiame
# Login del front
FRONT_USER=admin
FRONT_PASSWORD=cambiame
AUTH_SECRET=cadena-larga-aleatoria      # ej: openssl rand -hex 32
# IA
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Notificaciones por Telegram (opcional; ver doc/NOTIFICACIONES.md). Vacio = sin avisos externos.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
TIMEZONE=America/Bogota
# Version desplegada (la pone Terraform; en local puede quedar vacia)
DEPLOY_ID=
