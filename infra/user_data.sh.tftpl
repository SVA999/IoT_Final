#!/bin/bash
# Se ejecuta una vez como root en el primer arranque. Log: /var/log/plantas-bootstrap.log
exec > /var/log/plantas-bootstrap.log 2>&1
set -ex

export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y docker.io docker-compose-v2 git curl openssl

# CrateDB exige este parametro
echo "vm.max_map_count=262144" >> /etc/sysctl.conf
sysctl -w vm.max_map_count=262144

systemctl enable --now docker

cd /opt
git clone ${repo_url} IoT_Final
cd IoT_Final
cat > .env <<ENV
DWH_USER=dwh
DWH_PASSWORD=${dwh_password}
DWH_DB=plantas
FRONT_USER=${front_user}
FRONT_PASSWORD=${front_password}
AUTH_SECRET=$(openssl rand -hex 32)
CRATE_PASSWORD=${crate_password}
GEMINI_API_KEY=${gemini_api_key}
GEMINI_MODEL=gemini-3.6-flash
TELEGRAM_BOT_TOKEN=${telegram_bot_token}
TELEGRAM_CHAT_IDS=${telegram_chat_ids}
ENV
chmod 600 .env

docker compose up -d --build crate-db
bash doc/crate_auth.sh
docker compose up -d --build

# Esperar al Agente IoT y a Orion, y provisionar (grupo de servicio, dispositivo, suscripcion)
for i in $(seq 1 60); do
  curl -sf http://localhost:4041/iot/about && curl -sf http://localhost:1036/version && break
  sleep 5
done
bash doc/provisionar.sh localhost

# El camino principal del ETL es por EVENTOS (suscripcion de Orion -> servicio `processor`).
# Este cron cada 30 min es solo la red de seguridad: recupera lo que se perdio si el procesador estuvo caido.
#  - flock: nunca se solapan dos ejecuciones;  timeout: una ejecucion colgada se corta a los 4 min.
cat > /etc/cron.d/plantas-etl <<'CRON'
*/30 * * * * root cd /opt/IoT_Final && flock -n /var/lock/plantas-etl.lock timeout 240 docker compose run --rm -T etl >> /var/log/plantas-etl.log 2>&1
CRON
chmod 644 /etc/cron.d/plantas-etl
cat > /etc/logrotate.d/plantas-etl <<'LR'
/var/log/plantas-etl.log { weekly rotate 4 compress missingok notifempty }
LR
echo "BOOTSTRAP OK"
