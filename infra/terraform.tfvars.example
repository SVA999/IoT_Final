# Copiar a terraform.tfvars (ignorado por git) y completar
region         = "us-east-1"
key_name       = "vockey"                  # llave de AWS Academy
admin_cidr     = "0.0.0.0/0"               # quien puede entrar a SSH, Crate (4200) y Grafana (3000). Mejor "TU_IP/32"
repo_url       = "https://github.com/USUARIO/IoT_Final.git"
dwh_password   = "cambiame"
crate_password = "cambiame"                # sin comillas simples ni $
front_user     = "admin"
front_password = "cambiame"
gemini_api_key = ""                        # opcional; https://aistudio.google.com/apikey
telegram_bot_token = ""                    # opcional; ver doc/NOTIFICACIONES.md (BotFather)
telegram_chat_ids  = ""                    # opcional; ids separados por coma
